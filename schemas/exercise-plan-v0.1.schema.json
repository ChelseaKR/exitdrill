{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exitdrill.example/schemas/exercise-plan-v0.1.schema.json",
  "title": "ExitDrill synthetic exercise plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exercise_id",
    "data_mode",
    "source",
    "baseline",
    "target_sandbox",
    "workflow_probes",
    "evidence_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "exitdrill/exercise-plan/v0.1"
    },
    "exercise_id": {
      "type": "string",
      "minLength": 1
    },
    "data_mode": {
      "const": "synthetic_only"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "version",
        "export_mechanism",
        "customer_obtainable"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "export_mechanism": {
          "type": "string",
          "minLength": 1
        },
        "customer_obtainable": {
          "const": true
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_before_export",
        "coverage",
        "source_descriptions"
      ],
      "properties": {
        "captured_before_export": {
          "const": true
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entities",
            "relationships",
            "attachments",
            "permissions",
            "audit_events"
          ],
          "properties": {
            "entities": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "relationships": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "attachments": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "permissions": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "audit_events": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            }
          }
        },
        "source_descriptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "target_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "version",
        "empty",
        "isolated",
        "egress_blocked",
        "automations_disabled",
        "production_data_allowed"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "empty": {
          "const": true
        },
        "isolated": {
          "const": true
        },
        "egress_blocked": {
          "const": true
        },
        "automations_disabled": {
          "const": true
        },
        "production_data_allowed": {
          "const": false
        }
      }
    },
    "workflow_probes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "required"
        ],
        "properties": {
          "id": {
            "enum": [
              "authorized_access",
              "find_record",
              "retrieve_attachment",
              "traverse_relationships",
              "unauthorized_denial"
            ]
          },
          "kind": {
            "enum": [
              "attachment",
              "lookup",
              "permission_allow",
              "permission_deny",
              "relationship"
            ]
          },
          "required": {
            "const": true
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "const": "authorized_access"
              },
              "kind": {
                "const": "permission_allow"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "const": "find_record"
              },
              "kind": {
                "const": "lookup"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "const": "retrieve_attachment"
              },
              "kind": {
                "const": "attachment"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "const": "traverse_relationships"
              },
              "kind": {
                "const": "relationship"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "const": "unauthorized_denial"
              },
              "kind": {
                "const": "permission_deny"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "evidence_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_readback_required",
        "raw_disposition_matrix_required",
        "raw_remediation_matrix_required",
        "human_attestation_required"
      ],
      "properties": {
        "target_readback_required": {
          "const": true
        },
        "raw_disposition_matrix_required": {
          "const": true
        },
        "raw_remediation_matrix_required": {
          "const": true
        },
        "human_attestation_required": {
          "const": true
        }
      }
    }
  }
}
